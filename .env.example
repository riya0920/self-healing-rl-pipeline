# ============================================================
# Reddit API (optional — only needed for live scraping)
# Create a "script" app at https://www.reddit.com/prefs/apps
# ============================================================
REDDIT_CLIENT_ID=YOUR_CLIENT_ID_HERE
REDDIT_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
REDDIT_USER_AGENT=SelfHealingRL/1.0 by YOUR_USERNAME

# ============================================================
# LangSmith observability (optional)
# Sign up + create a key at https://smith.langchain.com/settings
# When LANGSMITH_API_KEY is set, every self-healing cycle is traced as a
# nested run: monitor -> diagnostics -> repair -> verification, with the
# MCP tool calls (retrain, validation, metrics) as child spans.
# Leave the key blank to run with tracing disabled (no-op, no overhead).
# ============================================================
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=self-healing-rl
# LANGSMITH_TRACING=false   # explicit kill-switch even if a key is present
